  "description": "A full-featured, ESM-compatible IOC diffing and normalization library + CLI for InfoSec tooling.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ioc-diff": "dist/bin/ioc-diff.js"
  },
  "keywords": [
    "ioc",
    "infosec",
    "threat-intel",
    "threat-intelligence",
    "security",
    "indicators-of-compromise",
    "yara",
    "sigma",
    "misp",
