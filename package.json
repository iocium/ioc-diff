    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.2.0"
